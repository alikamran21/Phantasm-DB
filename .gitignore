# Phantasm-DB .gitignore

# --- Secrets (NEVER commit these) ---
.env
.env.*
!.env.example
*.pem
*.key

# --- Python ---
__pycache__/
*.py[cod]
*.so
.venv/
venv/
env/
*.egg-info/
dist/
build/
.pytest_cache/
.ruff_cache/
htmlcov/
.coverage

# --- Node (if frontend tooling added later) ---
node_modules/
.npm/

# --- Docker ---
*.log

# --- OS ---
.DS_Store
Thumbs.db
